<?xml version="1.0" encoding="utf-8"?>
<!-- Один exe без установки .NET: dotnet publish src/DupFinder.App -p:PublishProfile=SingleFile -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Нативные dll WPF и SQLite тоже внутрь, иначе они лягут рядом с exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Без этого pdb ссылочного проекта (Core) ложится рядом с exe. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
