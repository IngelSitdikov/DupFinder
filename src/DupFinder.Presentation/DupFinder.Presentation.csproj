<Project Sdk="Microsoft.NET.Sdk">

  <!-- Общее для окон на WPF (Windows) и Avalonia (macOS): модель представления, настройки, строки.
       Без ссылок на UI-фреймворк — диалоги приходят снаружи через IUserDialogs. -->

  <ItemGroup>
    <ProjectReference Include="..\DupFinder.Core\DupFinder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Корзина macOS вызывается через [LibraryImport] к Objective-C runtime. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Нейтральные ресурсы — английские; русский перевод в Resources/*.ru.resx. -->
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Класс доступа к строкам перегенерируется при сборке, когда меняется Strings.resx, и лежит рядом
         с ним в репозитории. Он публичный: разметка обоих окон берёт строки через x:Static. -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>Resources\Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>DupFinder.Presentation</StronglyTypedNamespace>
      <!-- Имя ресурса внутри сборки идёт от папки (Resources), а не от пространства имён класса. -->
      <StronglyTypedManifestPrefix>DupFinder.Presentation.Resources</StronglyTypedManifestPrefix>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Strings.Designer.cs уже в Compile по шаблону **/*.cs, а генератор ресурсов добавляет его второй раз
       (CS2002). Оставляем одну запись. -->
  <Target Name="DedupeStringsDesigner" AfterTargets="CoreResGen">
    <ItemGroup>
      <Compile Remove="Resources\Strings.Designer.cs" />
      <Compile Include="Resources\Strings.Designer.cs" />
    </ItemGroup>
  </Target>

</Project>
